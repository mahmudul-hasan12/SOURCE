# SkySourcing BD - Environment Configuration

# ==============================================================================
# Cloud Database (Option 3: 100% Free MongoDB Atlas M0 Sandbox)
# ==============================================================================
# Instructions:
# 1. Sign up at https://www.mongodb.com/cloud/atlas (Free, no credit card required)
# 2. Create an M0 Free Cluster (512MB shared, forever free)
# 3. In "Network Access", add IP address: 0.0.0.0/0 (Allows Vercel serverless connections)
# 4. In "Database Access", create a database user and password
# 5. Click "Connect" -> "Drivers" -> Copy your connection string below:
#
# If MONGODB_URI is left empty or not set, SkySourcing automatically falls back
# to local JSON storage (data/*.json) so local development works without internet.

MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xyz.mongodb.net/skysourcing?retryWrites=true&w=majority
MONGODB_DB=skysourcing

# ==============================================================================
# Port & Host (Default: 3000)
# ==============================================================================
PORT=3000
NODE_ENV=development
